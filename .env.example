# La vista previa local funciona sin credenciales y no representa inventario real.
# En producción, configurar Supabase y mantener la vista previa desactivada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL y clave de servicio: solo servidor para importador, reseñas y estadísticas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CATALOG_PREVIEW=true

# Catálogo de demostración (solo desarrollo): habilita el flujo completo de
# carrito → cotización → WhatsApp con precios de ejemplo claramente marcados.
# No debe activarse en producción.
CATALOG_DEMO=false
